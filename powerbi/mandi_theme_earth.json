{
  "name": "Earthy Mandi",
  "dataColors": [
    "#8E5572",
    "#C49A6C",
    "#B5523B",
    "#7A8450",
    "#5C4033",
    "#D9B88F",
    "#A47551",
    "#6B705C"
  ],
  "background": "#FFFBF5",
  "foreground": "#3E2C23",
  "tableAccent": "#A47551",
  "good": "#7A8450",
  "neutral": "#C49A6C",
  "bad": "#B5523B",
  "maximum": "#B5523B",
  "center": "#E8D5B5",
  "minimum": "#7A8450",
  "textClasses": {
    "title": { "fontFace": "Segoe UI Semibold", "fontSize": 13, "color": "#3E2C23" },
    "header": { "fontFace": "Segoe UI Semibold", "fontSize": 12, "color": "#3E2C23" },
    "label": { "fontFace": "Segoe UI", "fontSize": 10, "color": "#7D6B5D" },
    "callout": { "fontFace": "Segoe UI Light", "fontSize": 30, "color": "#5C4033" }
  },
  "visualStyles": {
    "page": {
      "*": {
        "background": [{ "color": { "solid": { "color": "#F3ECE1" } }, "transparency": 0 }]
      }
    },
    "*": {
      "*": {
        "background": [{ "show": true, "color": { "solid": { "color": "#FFFBF5" } }, "transparency": 0 }],
        "border": [{ "show": true, "color": { "solid": { "color": "#E6D9C6" } }, "radius": 14 }],
        "dropShadow": [{ "show": true, "color": { "solid": { "color": "#5C4033" } }, "transparency": 88, "position": "Outer", "preset": "BottomRight" }],
        "visualHeader": [{ "show": false }],
        "title": [{ "fontColor": { "solid": { "color": "#3E2C23" } } }]
      }
    },
    "card": {
      "*": {
        "labels": [{ "color": { "solid": { "color": "#5C4033" } }, "fontSize": 30 }],
        "categoryLabels": [{ "color": { "solid": { "color": "#7D6B5D" } }, "fontSize": 10 }]
      }
    },
    "lineChart": {
      "*": {
        "lineStyles": [{ "strokeWidth": 3 }],
        "valueAxis": [{ "gridlineColor": { "solid": { "color": "#EDE3D4" } }, "labelColor": { "solid": { "color": "#7D6B5D" } } }],
        "categoryAxis": [{ "labelColor": { "solid": { "color": "#7D6B5D" } } }]
      }
    },
    "textbox": {
      "*": {
        "background": [{ "show": false }],
        "border": [{ "show": false }],
        "dropShadow": [{ "show": false }]
      }
    },
    "slicer": {
      "*": {
        "header": [{ "fontColor": { "solid": { "color": "#A47551" } }, "textSize": 11 }],
        "items": [{ "fontColor": { "solid": { "color": "#3E2C23" } } }]
      }
    }
  }
}
